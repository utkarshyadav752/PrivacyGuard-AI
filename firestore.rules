rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    // Pillar 2: Validation Blueprints
    function isValidAuditRecord(data) {
      return data.keys().hasAll([
          'ownerId',
          'actionType',
          'summary',
          'riskLevel',
          'itemsRemovedCount',
          'verifiedLocal',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'actionType',
          'summary',
          'riskLevel',
          'itemsRemovedCount',
          'verifiedLocal',
          'createdAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.actionType is string
        && data.actionType.size() <= 32
        && (data.actionType == 'photo_protect'
            || data.actionType == 'link_clean'
            || data.actionType == 'batch_protect'
            || data.actionType == 'ai_placeholder')
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 280
        && data.riskLevel is string
        && data.riskLevel.size() <= 16
        && (data.riskLevel == 'Low' || data.riskLevel == 'Moderate' || data.riskLevel == 'High')
        && data.itemsRemovedCount is int
        && data.itemsRemovedCount >= 0
        && data.itemsRemovedCount <= 10000
        && data.verifiedLocal is bool
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidUserPreference(data) {
      return data.keys().hasAll([
          'ownerId',
          'theme',
          'language',
          'historyEnabled',
          'defaultExportFormat',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'theme',
          'language',
          'historyEnabled',
          'defaultExportFormat',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.theme is string
        && data.theme.size() <= 16
        && (data.theme == 'dark' || data.theme == 'light' || data.theme == 'system')
        && data.language is string
        && data.language.size() <= 8
        && (data.language == 'en' || data.language == 'hi')
        && data.historyEnabled is bool
        && data.defaultExportFormat is string
        && data.defaultExportFormat.size() <= 32
        && (data.defaultExportFormat == 'image/jpeg'
            || data.defaultExportFormat == 'image/png'
            || data.defaultExportFormat == 'image/webp')
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Collection 1: Sanitized Audit Logs
    match /users/{userId}/auditLogs/{logId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId) && existing().ownerId == request.auth.uid;
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId) && isValidAuditRecord(incoming());
      allow update: if false;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId) && existing().ownerId == request.auth.uid;
    }

    // Collection 2: User Preferences
    match /users/{userId}/preferences/{prefId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(prefId) && existing().ownerId == request.auth.uid;
      allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(prefId) && isValidUserPreference(incoming());
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(prefId)
        && isValidUserPreference(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'theme',
          'language',
          'historyEnabled',
          'defaultExportFormat',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(prefId) && existing().ownerId == request.auth.uid;
    }
  }
}
